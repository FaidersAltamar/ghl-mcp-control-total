# =============================================================================
# GHL MCP — Credenciales (copia este archivo a .env y completa los valores)
# =============================================================================
# NUNCA subas .env a GitHub. Este .env.example sí puede ir al repo.
#
# Setup rápido:
#   cp .env.example .env    (Windows: copy .env.example .env)
#   npm install --prefix mcp/workflows
#   node scripts/workflows/list.mjs
# =============================================================================

# --- Location (obligatorio) ---
GHL_LOCATION_ID=your_location_id_here
GHL_DEFAULT_LOCATION_ID=your_location_id_here
GHL_COMPANY_ID=your_company_id_here

# --- API pública (PIT token) — contactos, ventas, calendarios, etc. ---
# GHL Settings > Integrations > Private Integrations
GHL_PIT_TOKEN=pit-your-token-here

# --- Workflows (API interna) — elige UNA de las dos opciones ---
# Opción A (recomendada): refresh token de Firebase desde GHL IndexedDB
GHL_FIREBASE_REFRESH_TOKEN=AMf-your-firebase-refresh-token-here
# Opción B (temporal): JWT Bearer de DevTools (expira ~1h)
# GHL_INTERNAL_JWT=

# --- API ---
GHL_API_VERSION=2021-07-28
GHL_API_BASE=https://services.leadconnectorhq.com

# --- OAuth Marketplace (opcional — solo para webhooks) ---
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
# GHL_OAUTH_ACCESS_TOKEN=
# GHL_OAUTH_REFRESH_TOKEN=

# --- Webhooks locales (opcional) ---
GHL_WEBHOOK_PORT=3000

# --- Cloudflare Worker webhooks (opcional) ---
GHL_WEBHOOK_ADMIN_SECRET=change-me-to-a-long-random-string
GHL_WEBHOOK_PATH=/webhooks/ghl
GHL_WEBHOOK_MAX_STORED=100
