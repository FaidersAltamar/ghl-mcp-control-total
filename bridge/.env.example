# Variables de entorno requeridas en Vercel (Settings -> Environment Variables)

# --- GHL ---
GHL_LOCATION_ID=
GHL_PIT_TOKEN=
GHL_FIREBASE_REFRESH_TOKEN=

# --- WasenderApi (la "API Access Key" del panel) ---
WASENDER_API_KEY=

# --- Seguridad del webhook (opcional pero recomendado) ---
# Mismo valor que pongas en Wasender -> Session -> Webhook Secret
WASENDER_WEBHOOK_SECRET=

# --- Personal Access Token (gestión de sesiones, opcional) ---
WASENDER_PAT=

# --- Chatbot IA ---
WA_BOT_ENABLED=true
# Números (sesión) en los que el bot responde, separados por coma. Vacío = todos.
WA_BOT_PHONES=+17863728411
# Modelo y endpoint (OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://r7k2xq9m.scal7.com/v1
AI_MODEL=faiders
# Turnos recientes que el bot mantiene en memoria antes de resumir (default 10)
WA_BOT_MEMORY_TURNS=10

# --- Conocimiento dinámico (Supabase) ---
# Tabla public.bot_knowledge. Si no se configuran, usa el conocimiento estático embebido.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Para actualizar la base de conocimiento vía POST /api/knowledge o refresh-knowledge.mjs
SUPABASE_SERVICE_KEY=

# --- Avisos de citas al equipo (POST /api/appointment-notify) ---
APPOINTMENT_NOTIFY_SECRET=
NOTIFY_FROM_PHONE=+17863728411
# Números de respaldo (si el principal se desconecta), separados por coma
NOTIFY_FALLBACK_PHONES=
TIKTOK_TEAM_PHONES=
META_TEAM_PHONES=
# Correos del equipo (copia con seguimiento vía API de conversaciones de GHL)
TIKTOK_TEAM_EMAILS=
META_TEAM_EMAILS=

# --- Bandeja de chats del sitio (Lovable) ---
# Endpoint del sitio que recibe los mensajes y clave compartida (también en server_secrets del sitio)
INBOX_INGEST_URL=
INBOX_SECRET=

# --- Dueño / staff ---
NOTIFY_OWNER_PHONE=
AGENDA_AUTHORIZED_PHONES=
